# Copy to collector.env; chmod 600. Use a separate narrow database user.
NODE_ENV=production
TZ=Asia/Kolkata
DB_HOST=database.internal
DB_PORT=5432
DB_NAME=iot
DB_USER=machine_api_user
DB_PASSWORD=REPLACE_WITH_RANDOM_PASSWORD
DB_SSL=true
DB_SSL_CA_FILE=/run/secrets/database-ca.pem
REDIS_HOST=redis.internal
REDIS_PORT=6380
REDIS_PASSWORD=REPLACE_WITH_RANDOM_PASSWORD
REDIS_TLS=true
REDIS_CA_FILE=/run/secrets/database-ca.pem
MQTT_URL=mqtts://broker.internal:8883
MQTT_USER=mexa-collector
MQTT_PASS=REPLACE_WITH_RANDOM_PASSWORD
MQTT_CLIENT_ID=mexa-factory-collector-1
NODE_EXTRA_CA_CERTS=/run/secrets/database-ca.pem
JOURNAL_DIR=/var/lib/mexa/journal
JOURNAL_MAX_MB=2048
MQTT_LOG_DIR=/var/log/mexa
HEALTH_PORT=3001
