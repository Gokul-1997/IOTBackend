# Build on the owner's CI, using the workspace parent as context.
ARG NODE_IMAGE=node:24-bookworm-slim
FROM ${NODE_IMAGE} AS dependencies
WORKDIR /app
COPY Backend/package.json Backend/package-lock.json ./
RUN npm ci --omit=dev && npm cache clean --force
FROM ${NODE_IMAGE}
ENV NODE_ENV=production DEPLOYMENT_MODE=on_prem
WORKDIR /app
COPY --from=dependencies --chown=node:node /app/node_modules ./node_modules
COPY --chown=node:node Backend/package.json ./
COPY --chown=node:node Backend/src ./src
COPY --chown=node:node Backend/scripts/migrate.js ./scripts/migrate.js
RUN mkdir -p /var/lib/mexa/storage && chown node:node /var/lib/mexa/storage
USER node
EXPOSE 8000
CMD ["node", "src/server.js"]
