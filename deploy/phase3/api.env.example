# Copy to api.env in the owner-controlled installation directory; chmod 600.
NODE_ENV=production
PORT=8000
TZ=Asia/Kolkata
DEPLOYMENT_MODE=on_prem
PHASE3_LICENSING_ENABLED=false
LICENSE_SERVER_URL=https://license.example.com/api/licensing/lease
LICENSE_COMPANY_ID=1
LICENSE_INSTALLATION_ID=REPLACE_WITH_OWNER_ISSUED_UUID
POSTGRESQL_HOST=database.internal
POSTGRESQL_PORT=5432
POSTGRESQL_DATABASE=iot
POSTGRESQL_USER=mexa_api
POSTGRESQL_PASSWORD=REPLACE_WITH_RANDOM_PASSWORD
DB_SSL=true
DB_SSL_CA_FILE=/run/secrets/database-ca.pem
REDIS_URL=rediss://default:REPLACE_WITH_ENCODED_PASSWORD@redis.internal:6380
NODE_EXTRA_CA_CERTS=/run/secrets/database-ca.pem
JWT_SECRET=REPLACE_WITH_UNIQUE_RANDOM_SECRET
CORS_ORIGINS=https://factory.example.com
FRONTEND_URL=https://factory.example.com
STORAGE_ROOT=/var/lib/mexa/storage
# Run scheduled jobs on exactly one API instance.
CRON_ENABLED=true
