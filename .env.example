# API server (Backend) — every variable the code reads (checked 7 Oct 2026).
# Copy to .env on the server. Never commit the real .env.

NODE_ENV=production
PORT=8000
# All dates and shifts are worked out in IST. Also set in ecosystem.config.js.
TZ=Asia/Kolkata

# Browser origins allowed to call this API, comma separated, with scheme.
# REQUIRED in production: unset, every browser request fails CORS.
CORS_ORIGINS=https://stmmexa.stmcnc.com
# Where links in e-mails (password reset) point
FRONTEND_URL=https://stmmexa.stmcnc.com

# Postgres
POSTGRESQL_HOST=127.0.0.1
POSTGRESQL_PORT=5432
POSTGRESQL_USER=pms_user
POSTGRESQL_PASSWORD=change-me
POSTGRESQL_DATABASE=iot
# 'true' / 'false'. Default: on when NODE_ENV=production.
#DB_SSL=true
# TLS validates the server certificate. For a private/RDS CA, configure its file.
#DB_SSL_CA_FILE=/etc/iot/database-ca.pem
# Connections in the pool (default 20) and the longest one query may run (default 60000 ms)
#DB_POOL_MAX=20
#DB_STATEMENT_TIMEOUT_MS=60000

# Redis — the live-data channel from the collector, rate limits, caches
REDIS_URL=redis://:change-me@127.0.0.1:6379

# Signing key for access tokens. At least 32 random characters:
#   openssl rand -base64 48
# Changing it means everyone signs in again once.
JWT_SECRET=change-me-to-48-random-characters

# Signed-in devices per user (default 5); the oldest is signed out beyond that
#MAX_SESSIONS_PER_USER=5

# Exports, reports and long telemetry windows running at once: per company
# (default 3) and in all (default 8), so one company's reporting cannot take
# the database connections every other company's dashboards need
#HEAVY_PER_COMPANY=3
#HEAVY_OVERALL=8

# Scheduled jobs (OEE roll-ups, PM tickets). Set false on every machine that
# is not the production API server — e.g. a developer laptop pointed at prod.
#CRON_ENABLED=true

# Private files on this API server. Keep outside the application checkout on
# a persistent disk. Omit to use Backend/storage in development.
STORAGE_ROOT=/opt/iot/storage

# Mail (password reset, reports)
EMAIL_USER=
EMAIL_PASS=

# Program transfer: optional OLD root, only for files saved before unified
# STORAGE_ROOT storage. Keep its existing value until old files are migrated.
#PROGRAM_TRANSFER_DIR=/opt/iot/storage/ProgramTransfer
#PROGRAM_MAX_MB=20
#DEVICE_POLL_SECONDS=15

# Reports: a download larger than this many rows is built in the background
# and emailed instead (the screen says "check your email in 10–15 minutes").
#REPORT_DIRECT_ROWS=20000

# Report assistant ("STM Mexa AI"). Without ANTHROPIC_API_KEY it stays hidden.
# Questions and the report figures it reads are sent to Anthropic's API to be
# answered (Anthropic's API data terms apply); MEXA keeps only per-person
# daily counts (answers, questions, tokens).
# Run migration 052 first. docs/REPORT_ASSISTANT.md
#ANTHROPIC_API_KEY=
# only for a key not scoped to a workspace (console.anthropic.com → Workspaces)
#ANTHROPIC_WORKSPACE_ID=
#ASSISTANT_NAME=STM Mexa AI
#ASSISTANT_MODEL=claude-haiku-5-5
#ASSISTANT_MAX_TOKENS=1024
#ASSISTANT_TIMEOUT_MS=45000
#ASSISTANT_MAX_CONCURRENT=8
# What it may cost (the platform pays every model call; migration 054):
# the most answers a day a company admin may give each person,
#ASSISTANT_DAILY_LIMIT_MAX=100
# questions a day for a whole company, everyone together,
#ASSISTANT_COMPANY_DAILY_MAX=500
# and questions a minute from one person.
#ASSISTANT_PER_MINUTE=6
# Set a monthly spending limit in console.anthropic.com as well.
