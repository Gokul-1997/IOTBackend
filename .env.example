# API server
NODE_ENV=development
PORT=8000

# Browser origins allowed to call this API, comma separated.
# REQUIRED when NODE_ENV=production: with it unset, src/app.js sends no
# Access-Control-Allow-Origin header at all and every browser request fails
# with "blocked by CORS policy" — the API looks up, but nothing can log in.
# Include the scheme, and app://localhost as well when the Electron build is used.
CORS_ORIGINS=http://localhost:4200

# Postgres
POSTGRESQL_HOST=localhost
POSTGRESQL_PORT=5432
POSTGRESQL_USER=postgres
POSTGRESQL_PASSWORD=changeme
POSTGRESQL_DATABASE=iot

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT
JWT_SECRET=changeme-strong-random-string
JWT_EXPIRES_IN=8h

# AWS (S3 for uploads)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
S3_BUCKET=

# SMTP (nodemailer)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
